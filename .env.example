# Optional Google OIDC identity verification. These values do not grant DOC permissions.
DOC_APP_URL=https://your-doc-host.example
DOC_GOOGLE_CLIENT_ID=
DOC_GOOGLE_CLIENT_SECRET=
# Transitional shared-session signing secret. Do not reuse ISEYC_STAFF_KEY.
DOC_SESSION_SECRET=
# Separate random secret (at least 32 bytes) for short-lived pending Google identity proofs.
DOC_IDENTITY_PROOF_SECRET=

# Reserved for the restricted identity/governance registers; not consumed by this code yet.
NOTION_MEMBERSHIP_DATABASE_ID=
NOTION_APPOINTMENTS_DATABASE_ID=
NOTION_DELEGATIONS_DATABASE_ID=
NOTION_ACCESS_AUDIT_DATABASE_ID=

# Required only when the individual DOC PIN flow is implemented and enabled.
# Keep a random secret of at least 32 bytes in encrypted Vercel environment variables.
DOC_PIN_PEPPER=
